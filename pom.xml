<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 3.5.16 is the Boot 3 line declared by langchain4j-spring 1.23.0-beta33. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>bank-agent-java</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <name>bank-agent-java</name>
    <description>Banking AI Agent (Java) - local demo (simulated banking only) with Galileo instrumentation: Observe via the OpenTelemetry Java agent + LangChain4j listeners, Agent Control at business gates</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <langchain4j.version>1.23.0</langchain4j.version>
        <!-- Official OpenTelemetry Java agent that scripts/run.sh attaches in Observe mode. Keep in sync with
             OTEL_JAVAAGENT_VERSION / OTEL_JAVAAGENT_SHA256 in scripts/lib/common.sh (checked by OtelJavaAgentIT). -->
        <otel.javaagent.version>2.33.1</otel.javaagent.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- LangChain4j AI Services, tools, chat memory and the native OpenAI client. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Galileo Observe: only the OpenTelemetry API (version managed by the Spring Boot BOM). The SDK, the
            OTLP exporter, sampling and batching come from the official OpenTelemetry Java agent, which
            scripts/run.sh attaches with -javaagent only when Observe is on. Without the agent the API is a no-op.
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-process span assertions (in-memory exporter). -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- OtelJavaAgentIT: decodes the OTLP/protobuf requests the real Java agent sends to a loopback receiver. -->
        <dependency>
            <groupId>io.opentelemetry.proto</groupId>
            <artifactId>opentelemetry-proto</artifactId>
            <version>1.8.0-alpha</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>bank-agent-java</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Tests are fully offline: never load the private secrets / galileo files, a real API key or AO credentials. -->
                    <environmentVariables>
                        <OPENAI_API_KEY></OPENAI_API_KEY>
                        <BANK_AGENT_SECRETS_FILE>/nonexistent/bank-agent-test-secrets.properties</BANK_AGENT_SECRETS_FILE>
                        <BANK_AGENT_GALILEO_FILE>/nonexistent/bank-agent-test-galileo.properties</BANK_AGENT_GALILEO_FILE>
                        <OBSERVABILITY_ENABLED>false</OBSERVABILITY_ENABLED>
                        <CONTROL_MODE>off</CONTROL_MODE>
                        <DEMO_TRACE_CONTENT>false</DEMO_TRACE_CONTENT>
                        <AO_BACKEND_PROFILE></AO_BACKEND_PROFILE>
                        <AO_REALM></AO_REALM>
                        <AO_O11Y_TOKEN></AO_O11Y_TOKEN>
                        <AO_O11Y_API_TOKEN></AO_O11Y_API_TOKEN>
                        <AO_API_KEY></AO_API_KEY>
                        <AO_CONSOLE_URL></AO_CONSOLE_URL>
                        <AO_API_URL></AO_API_URL>
                        <AO_OTLP_ENDPOINT></AO_OTLP_ENDPOINT>
                        <AGENT_CONTROL_URL></AGENT_CONTROL_URL>
                        <AGENT_CONTROL_API_KEY></AGENT_CONTROL_API_KEY>
                    </environmentVariables>
                    <systemPropertyVariables>
                        <BANK_AGENT_SECRETS_FILE>/nonexistent/bank-agent-test-secrets.properties</BANK_AGENT_SECRETS_FILE>
                        <BANK_AGENT_GALILEO_FILE>/nonexistent/bank-agent-test-galileo.properties</BANK_AGENT_GALILEO_FILE>
                        <OPENAI_API_KEY></OPENAI_API_KEY>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <!-- The black-box test OtelJavaAgentIT starts the packaged application with this exact agent jar. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-otel-javaagent</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>io.opentelemetry.javaagent</groupId>
                                    <artifactId>opentelemetry-javaagent</artifactId>
                                    <version>${otel.javaagent.version}</version>
                                    <destFileName>opentelemetry-javaagent.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/otel-javaagent</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Runs *IT integration tests (Spring context + in-memory H2 + scripted model, and the black-box
                     OtelJavaAgentIT that launches the packaged jar with the real -javaagent) during verify. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <environmentVariables>
                        <OPENAI_API_KEY></OPENAI_API_KEY>
                        <BANK_AGENT_SECRETS_FILE>/nonexistent/bank-agent-test-secrets.properties</BANK_AGENT_SECRETS_FILE>
                        <BANK_AGENT_GALILEO_FILE>/nonexistent/bank-agent-test-galileo.properties</BANK_AGENT_GALILEO_FILE>
                        <OBSERVABILITY_ENABLED>false</OBSERVABILITY_ENABLED>
                        <CONTROL_MODE>off</CONTROL_MODE>
                        <DEMO_TRACE_CONTENT>false</DEMO_TRACE_CONTENT>
                        <AO_BACKEND_PROFILE></AO_BACKEND_PROFILE>
                        <AO_REALM></AO_REALM>
                        <AO_O11Y_TOKEN></AO_O11Y_TOKEN>
                        <AO_O11Y_API_TOKEN></AO_O11Y_API_TOKEN>
                        <AO_API_KEY></AO_API_KEY>
                        <AO_CONSOLE_URL></AO_CONSOLE_URL>
                        <AO_API_URL></AO_API_URL>
                        <AO_OTLP_ENDPOINT></AO_OTLP_ENDPOINT>
                        <AGENT_CONTROL_URL></AGENT_CONTROL_URL>
                        <AGENT_CONTROL_API_KEY></AGENT_CONTROL_API_KEY>
                    </environmentVariables>
                    <systemPropertyVariables>
                        <BANK_AGENT_SECRETS_FILE>/nonexistent/bank-agent-test-secrets.properties</BANK_AGENT_SECRETS_FILE>
                        <BANK_AGENT_GALILEO_FILE>/nonexistent/bank-agent-test-galileo.properties</BANK_AGENT_GALILEO_FILE>
                        <OPENAI_API_KEY></OPENAI_API_KEY>
                        <bank.it.appJar>${project.build.directory}/${project.build.finalName}.jar</bank.it.appJar>
                        <bank.it.otelAgentJar>${project.build.directory}/otel-javaagent/opentelemetry-javaagent.jar</bank.it.otelAgentJar>
                        <bank.it.otelAgentVersion>${otel.javaagent.version}</bank.it.otelAgentVersion>
                        <bank.it.projectDir>${project.basedir}</bank.it.projectDir>
                        <bank.it.reportDir>${project.build.directory}/otel-javaagent-it</bank.it.reportDir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Only for tools/protocol-probes/run-probe.sh (local protocol verification of 2026-11-02): the probes build their
            own OTel SDK + OTLP exporter on purpose. The application itself never ships an SDK - Observe uses the
            OpenTelemetry Java agent.
        -->
        <profile>
            <id>protocol-probes</id>
            <dependencies>
                <dependency>
                    <groupId>io.opentelemetry</groupId>
                    <artifactId>opentelemetry-sdk</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.opentelemetry</groupId>
                    <artifactId>opentelemetry-exporter-otlp</artifactId>
                    <exclusions>
                        <exclusion>
                            <groupId>io.opentelemetry</groupId>
                            <artifactId>opentelemetry-exporter-sender-okhttp</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>io.opentelemetry</groupId>
                    <artifactId>opentelemetry-exporter-sender-jdk</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
